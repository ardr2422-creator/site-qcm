# ─────────────────────────────────────────────────────────────────────────
#  Les Secrets Gourmands d'Argenteuil — variables d'environnement
#
#  En local : copiez ce fichier en « .env.local » puis remplissez-le.
#  Sur Vercel : Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────

# Facultatif. Adresse publique du site, vers laquelle pointent les QR codes.
# Par défaut : https://qcm-argenteuil.vercel.app — ne la renseignez que si
# l'adresse change (nom de domaine personnalisé, par exemple).
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
#   • « Project URL »
#   • clé « service_role » (secrète : ne jamais la préfixer par NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe de l'espace organisateur (/admin). Choisissez-le long.
ADMIN_PASSWORD=
